# Plantilla: copia este archivo como .env y completa con tus datos reales.
# NUNCA subas el .env a git (ya esta en .gitignore).

# Cadena de conexion de Aiven PostgreSQL
DATABASE_URL=postgres://USUARIO:CLAVE@HOST:PUERTO/defaultdb

# Certificado CA de Aiven (opcional). Pegarlo en una sola linea con \n
DB_CA_CERT=

# Clave compartida con el ESP32 (va en el header x-api-key)
API_KEY=CAMBIA_ESTA_CLAVE

# Distancia del sensor al fondo del sumidero, en cm
ALTURA_SENSOR_CM=100
